# Single LiteLLM gateway (legacy form). Ignored when GATEWAYS is set.
SWARM_KEY=
LITELLM_MASTER_KEY=
LITELLM_URL=http://fred-litellm-gateway:4000

# Several gateways, each with its own swarm key, an admin key (used only to block/unblock that key) and its Fabric VCs.
# One line of JSON; a VC without "uuid" is simulated. See README section 3.
# GATEWAYS=[{"name":"LLM Gateway CH-128","type":"litellm","url":"http://fred-litellm-gateway:4000","key":"","admin_key":"","vcs":[{"name":"Google Cloud - Partner Interconnect","provider":"gcp","uuid":""},{"name":"AWS - Direct Connect","provider":"aws","uuid":""}]}]

# Real hard kill (Fabric VC delete). Guarded: only connections named fred-hackathon* are ever deleted; dry run by default.
# FABRIC_CLIENT_ID=
# FABRIC_CLIENT_SECRET=
# FABRIC_DRY_RUN=1
